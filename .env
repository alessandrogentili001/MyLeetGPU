#!/usr/bin/env bash
# ==============================================================================
# MyLeetGPU Environment Configuration for Leonardo Booster (NVIDIA A100-64GB)
# Usage: source .env  (or: source env.sh)
# ==============================================================================

# Ensure script is being sourced, not executed directly
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    echo "[-] Error: Please source this script: 'source ${BASH_SOURCE[0]}'" >&2
    exit 1
fi

echo "=================================================================="
echo "           🚀 Initializing MyLeetGPU Environment                 "
echo "=================================================================="

# 1. Load Leonardo Environment Modules
# Note: cuda/12.2 matches Leonardo's kernel driver (535.x)
module purge 2>/dev/null || true
module load gcc/12.2.0
module load cuda/12.2
module load cmake/3.27.9
module load ninja/1.11.1

# 2. CUDA & Architecture Configuration
export CUDA_HOME="${CUDA_HOME:-$(dirname $(dirname $(which nvcc)))}"
export CUDA_ROOT="${CUDA_HOME}"
export CUDA_PATH="${CUDA_HOME}"

# NVIDIA A100-SXM4-64GB (Ampere sm_80)
export CUDA_ARCH="80"
export CMAKE_CUDA_ARCHITECTURES="80"
export TORCH_CUDA_ARCH_LIST="8.0"

# Path & Library Paths
export PATH="${CUDA_HOME}/bin:${PATH}"
export LD_LIBRARY_PATH="${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}"

# 3. Leonardo SLURM Settings (PHD_gentili allocation)
export SLURM_ACCOUNT="PHD_gentili"
export SLURM_PARTITION="boost_usr_prod"
export SLURM_QOS="boost_qos_dbg"

# 4. Project Root
export MYLEETGPU_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# 5. Workflow Helpers
# Allocate an interactive A100 GPU shell (30 mins in fast debug queue)
alias leetgpu-alloc="salloc -A ${SLURM_ACCOUNT} -p ${SLURM_PARTITION} --qos=${SLURM_QOS} --gres=gpu:1 -t 00:30:00 --pty bash"

# Run any command / binary on an A100 GPU node via srun
leetgpu-run() {
    if [ $# -eq 0 ]; then
        echo "Usage: leetgpu-run <command | ./path/to/binary> [args...]"
        echo "Example: leetgpu-run nvidia-smi"
        echo "Example: leetgpu-run ./build/problems/01_vector_add/vector_add"
        return 1
    fi
    srun -A "${SLURM_ACCOUNT}" -p "${SLURM_PARTITION}" --qos="${SLURM_QOS}" --gres=gpu:1 -t 00:05:00 bash -c '"$@"' _ "$@"
}

# Quick build shortcut with CMake
leetgpu-build() {
    local build_dir="${MYLEETGPU_ROOT}/build"
    mkdir -p "${build_dir}"
    cmake -B "${build_dir}" -S "${MYLEETGPU_ROOT}" -DCMAKE_BUILD_TYPE=Release -DCMAKE_CUDA_ARCHITECTURES="${CMAKE_CUDA_ARCHITECTURES}"
    cmake --build "${build_dir}" -j"$(nproc 2>/dev/null || echo 4)"
}

# 6. Status Banner
echo "------------------------------------------------------------------"
echo " ✅ GCC Compiler : $(gcc -dumpfullversion 2>/dev/null || gcc --version | head -n1)"
echo " ✅ NVCC Version : $(nvcc --version 2>/dev/null | grep release | awk '{print $5, $6}' | tr -d ',')"
echo " ✅ CMake Version: $(cmake --version 2>/dev/null | head -n1 | awk '{print $3}')"
echo " ✅ Target GPU   : NVIDIA A100-SXM4-64GB (sm_${CUDA_ARCH})"
echo " ✅ Slurm Account: ${SLURM_ACCOUNT} (Partition: ${SLURM_PARTITION}, QoS: ${SLURM_QOS})"
echo "------------------------------------------------------------------"
echo " 💡 Quick commands:"
echo "    • source .env               -> Re-source environment anytime"
echo "    • leetgpu-build             -> Compile all problems"
echo "    • leetgpu-run <binary>      -> Run binary on Leonardo A100 GPU"
echo "    • leetgpu-alloc             -> Interactive bash on A100 GPU"
echo "=================================================================="
